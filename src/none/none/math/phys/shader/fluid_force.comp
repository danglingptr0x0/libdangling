#version 460

layout(local_size_x = 8, local_size_y = 8, local_size_z = 4) in;

layout(std430, binding = 0) buffer vel_z_blk { double vel_z[]; };
layout(std430, binding = 1) readonly buffer param_blk
{
    double dt;
    double spacing;
    double density;
    double gravity;
    double tol;
    double pudding_d;
    uint nx;
    uint ny;
    uint nz;
    uint pudding_a;
};

void main()
{
    uint idx_x = gl_GlobalInvocationID.x;
    uint idx_y = gl_GlobalInvocationID.y;
    uint idx_z = gl_GlobalInvocationID.z;
    if (idx_x >= nx || idx_y >= ny || idx_z >= nz + 1u) { return; }

    vel_z[(idx_z * ny + idx_y) * nx + idx_x] += gravity * dt;
}
