#version 460

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) writeonly buffer drive_blk { double drive[]; };
layout(std430, binding = 1) readonly buffer param_blk
{
    double spacing;
    uint nx;
    uint ny;
    uint nz;
    uint pudding;
};

void main()
{
    uint cell = gl_GlobalInvocationID.x;
    if (cell >= nx * ny * nz) { return; }

    drive[cell] = 0.0lf;
}
