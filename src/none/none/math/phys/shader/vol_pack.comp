#version 460

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

layout(std430, binding = 0) readonly buffer electric_blk { double electric[]; };
layout(std430, binding = 1) readonly buffer magnetic_blk { double magnetic[]; };
layout(std430, binding = 2) writeonly buffer pack_blk { double pack_out[]; };
layout(std430, binding = 3) readonly buffer pack_param_blk
{
    uint nx;
    uint ny;
    uint nz;
    uint vol_stride;
    uint vol_x;
    uint vol_y;
    uint vol_z;
    uint slice_z;
};

void main()
{
    uint idx_x = gl_GlobalInvocationID.x;
    uint idx_y = gl_GlobalInvocationID.y;
    uint idx_z = gl_GlobalInvocationID.z;
    if (idx_x >= vol_x || idx_y >= vol_y || idx_z >= vol_z) { return; }

    uint cell_cunt = nx * ny * nz;
    uint vol_cunt = vol_x * vol_y * vol_z;
    uint cell = ((idx_z * vol_stride) * ny + (idx_y * vol_stride)) * nx + (idx_x * vol_stride);
    uint vcell = (idx_z * vol_y + idx_y) * vol_x + idx_x;
    for (uint comp = 0u; comp < 3u; comp++)
    {
        pack_out[comp * vol_cunt + vcell] = electric[comp * cell_cunt + cell];
        pack_out[(comp + 3u) * vol_cunt + vcell] = magnetic[comp * cell_cunt + cell];
    }
}
