#version 460

layout(local_size_x = 8, local_size_y = 8, local_size_z = 4) in;

layout(std430, binding = 0) buffer magnetic_blk { double magnetic[]; };
layout(std430, binding = 1) readonly buffer electric_blk { double electric[]; };
layout(std430, binding = 2) readonly buffer param_blk
{
    double inv_spacing;
    double coeff_ca;
    double coeff_cb;
    double coeff_db;
    uint nx;
    uint ny;
    uint nz;
    uint pml_depth;
};
layout(std430, binding = 3) buffer batch_blk
{
    uint seq;
    uint pudding_seq;
    double drive_series[4 * 255];
    double tap_ring[8 * 255];
};
layout(std430, binding = 4) readonly buffer tap_param_blk
{
    double frac_x[8];
    double frac_y[8];
    double frac_z[8];
    double src_weight[8];
    uint corner[8];
    uint stride_y;
    uint stride_z;
    uint batch_cap;
    uint probe_cunt;
    uint src_cell[8];
    uint src_comp[8];
    uint src_slot[8];
    uint src_cunt;
    uint pudding_src[3];
};

void main()
{
    uint idx_x = gl_GlobalInvocationID.x;
    uint idx_y = gl_GlobalInvocationID.y;
    uint idx_z = gl_GlobalInvocationID.z;
    if (idx_x >= nx || idx_y >= ny || idx_z >= nz) { return; }

    uint cell_cunt = nx * ny * nz;
    uint plane = nx * ny;
    uint center = (idx_z * ny + idx_y) * nx + idx_x;
    double diff_a = 0.0;
    double diff_b = 0.0;
    if (idx_x == 0u && idx_y == 0u && idx_z == 0u)
    {
        uint tick = seq;
        for (uint probe_idx = 0u; probe_idx < probe_cunt; probe_idx++)
        {
            uint probe = 2u * cell_cunt + corner[probe_idx];
            double lo_val = 0.0;
            double hi_val = 0.0;
            double front = 0.0;
            double back = 0.0;
            lo_val = electric[probe] + (electric[probe + 1u] - electric[probe]) * frac_x[probe_idx];
            hi_val = electric[probe + stride_y] + (electric[probe + stride_y + 1u] - electric[probe + stride_y]) * frac_x[probe_idx];
            front = lo_val + (hi_val - lo_val) * frac_y[probe_idx];
            lo_val = electric[probe + stride_z] + (electric[probe + stride_z + 1u] - electric[probe + stride_z]) * frac_x[probe_idx];
            hi_val = electric[probe + stride_z + stride_y] + (electric[probe + stride_z + stride_y + 1u] - electric[probe + stride_z + stride_y]) * frac_x[probe_idx];
            back = lo_val + (hi_val - lo_val) * frac_y[probe_idx];
            tap_ring[tick * 8u + probe_idx] = front + (back - front) * frac_z[probe_idx];
        }
        seq = tick + 1u;
    }

    if (pml_depth > 0u)
    {
        if (!(idx_x >= pml_depth && idx_x + pml_depth + 1u < nx && idx_y >= pml_depth && idx_y + pml_depth + 1u < ny && idx_z >= pml_depth && idx_z + pml_depth + 1u < nz)) { return; }
    }

    if (idx_y + 1u < ny && idx_z + 1u < nz)
    {
        diff_a = (electric[2u * cell_cunt + center + nx] - electric[2u * cell_cunt + center]) * inv_spacing;
        diff_b = (electric[cell_cunt + center + plane] - electric[cell_cunt + center]) * inv_spacing;
        magnetic[center] -= coeff_db * (diff_a - diff_b);
    }

    if (idx_x + 1u < nx && idx_z + 1u < nz)
    {
        diff_a = (electric[center + plane] - electric[center]) * inv_spacing;
        diff_b = (electric[2u * cell_cunt + center + 1u] - electric[2u * cell_cunt + center]) * inv_spacing;
        magnetic[cell_cunt + center] -= coeff_db * (diff_a - diff_b);
    }

    if (idx_x + 1u < nx && idx_y + 1u < ny)
    {
        diff_a = (electric[cell_cunt + center + 1u] - electric[cell_cunt + center]) * inv_spacing;
        diff_b = (electric[center + nx] - electric[center]) * inv_spacing;
        magnetic[2u * cell_cunt + center] -= coeff_db * (diff_a - diff_b);
    }
}
